# TabbyAPI 2026-08-24 / ExLlamaV3 1.4.3. Pin the verified upstream image so
# future rebuilds do not silently change runtime behavior.
FROM ghcr.io/theroyallab/tabbyapi@sha256:216d451735e9050337f7fa2073d7cec603bc501d0fd82d53294722350cbcc665

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        python3.12-dev \
    && rm -rf /var/lib/apt/lists/*
