# Only the Open WebUI process reads this file. Keep it mode 0600.
# It must never contain LITELLM_MASTER_KEY or Azure provider keys.

# PostgreSQL role/database dedicated to Open WebUI.
DATABASE_URL=postgresql://openwebui:REPLACE_WITH_OPENWEBUI_DB_PASSWORD@127.0.0.1:5432/openwebui
WEBUI_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_VALUE
# The main site is Visionnaire Flutter. Open WebUI gets its own prefixed route.
WEBUI_URL=https://ai.changdar-server.mooo.com
CORS_ALLOW_ORIGIN=https://ai.changdar-server.mooo.com
WEBUI_SESSION_COOKIE_SECURE=true
WEBUI_AUTH_COOKIE_SECURE=true
WEBUI_SESSION_COOKIE_SAME_SITE=lax
WEBUI_AUTH_COOKIE_SAME_SITE=lax
OAUTH_MAX_SESSIONS_PER_USER=10
JWT_EXPIRES_IN=8h

# Open WebUI -> LiteLLM. This is a restricted LiteLLM virtual key, generated
# only after LiteLLM has its own database. It is not the LiteLLM master key.
OPENAI_API_BASE_URLS=http://127.0.0.1:4000/v1
OPENAI_API_KEYS=sk-REPLACE_WITH_OPENWEBUI_BACKEND_VIRTUAL_KEY

# This Function-only virtual key is deliberately separate from the ordinary
# Open WebUI key above. Official-document cloud processing has no end-user
# `user` field, so this key's service budget (not a user's daily budget) is
# charged. Keep it out of browsers, Flutter apps, Function Valves and git.
OFFICIAL_DOCUMENT_LITELLM_BASE_URL=http://127.0.0.1:4000/v1
OFFICIAL_DOCUMENT_LITELLM_API_KEY=sk-REPLACE_WITH_OFFICIAL_DOCUMENT_SERVICE_KEY

# Web search is performed by the local private SearXNG service. Its Docker
# port must be bound to 127.0.0.1 only, not published to the network.
ENABLE_WEB_SEARCH=true
WEB_SEARCH_ENGINE=searxng
SEARXNG_QUERY_URL=http://127.0.0.1:8888/search
SEARXNG_LANGUAGE=all
WEB_SEARCH_RESULT_COUNT=5

# Keycloak realm `visionnaire` OIDC client `open-webui`.
# Do not create a second account/password directory in Open WebUI.
ENABLE_PASSWORD_AUTH=false
ENABLE_LOGIN_FORM=false
ENABLE_PASSWORD_CHANGE_FORM=true
ENABLE_OAUTH_SIGNUP=true
OAUTH_CLIENT_ID=open-webui
OAUTH_CLIENT_SECRET=REPLACE_WITH_KEYCLOAK_CLIENT_SECRET
OPENID_PROVIDER_URL=https://changdar-server.mooo.com/keycloak/realms/visionnaire/.well-known/openid-configuration
OPENID_REDIRECT_URI=https://ai.changdar-server.mooo.com/oauth/oidc/callback
OAUTH_PROVIDER_NAME=Visionnaire SSO
OAUTH_SCOPES=openid profile email
OAUTH_SUB_CLAIM=sub
OAUTH_USERNAME_CLAIM=preferred_username
ENABLE_OAUTH_EMAIL_FALLBACK=true
OAUTH_MERGE_ACCOUNTS_BY_EMAIL=false
ENABLE_OAUTH_PERSISTENT_CONFIG=false

# Only client roles explicitly mapped into the OIDC token are accepted.
ENABLE_OAUTH_ROLE_MANAGEMENT=true
OAUTH_ROLES_CLAIM=resource_access.open-webui.roles
OAUTH_ALLOWED_ROLES=openwebui-user,openwebui-admin
OAUTH_ADMIN_ROLES=openwebui-admin

# Keycloak is the source of truth for shared Visionnaire/Open WebUI group
# membership. The `visionnaire-groups` mapper emits full Keycloak paths in the
# standard `groups` claim, e.g. /engineering/site-a. Open WebUI mirrors those
# names and updates membership at every OIDC login.
ENABLE_OAUTH_GROUP_MANAGEMENT=true
ENABLE_OAUTH_GROUP_CREATION=true
OAUTH_GROUPS_CLAIM=groups
OAUTH_BLOCKED_GROUPS=[]

# The following header contains Open WebUI's local UUID, not the Keycloak
# subject. Leave this disabled; quota identity is injected by the trusted
# server-side Filter described in docs/visionnaire-ai-integration.md.
ENABLE_FORWARD_USER_INFO_HEADERS=false

# Scheduled EIP calendar reservation when the source has a start but no end.
# Allowed: 60 or 120 minutes. This is not an authoritative source end time.
EIP_CALENDAR_DEFAULT_DURATION_MINUTES=60

# Company assistant NAS identity. Configure via a server environment/drop-in.
# COMPANY_AGENT_NAS_URL=https://nas.example.com:5001
# Optional verified HTTPS route to the SAME NAS after an office/network move.
# Existing encrypted credentials and binding revisions continue to use NAS_URL.
# COMPANY_AGENT_NAS_CONNECT_URL=https://verified-nas-relay.example.com
