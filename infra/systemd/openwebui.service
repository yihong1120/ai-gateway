[Unit]
Description=Open WebUI with Visionnaire Keycloak SSO
After=network-online.target ai-gateway-litellm.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/changdar/Documents/ai-gateway
EnvironmentFile=/home/changdar/Documents/ai-gateway/.env.openwebui
Environment=EIP_WEBUI_ORIGIN=https://ai.changdar-server.mooo.com
Environment=EIP_AUTOMATION_KEY_FILE=/home/changdar/.local/state/ai-gateway/secrets/eip-automation.key
ExecStart=/home/changdar/.conda/envs/webui_env/bin/python -m official_document_workflow.api.serve
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
