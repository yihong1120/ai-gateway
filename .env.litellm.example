# Only the LiteLLM process reads this file.  Keep the real .env.litellm at
# mode 0600 and do not copy values into .env.openwebui.

# PostgreSQL role/database dedicated to LiteLLM.
LITELLM_DATABASE_URL=postgresql://litellm:REPLACE_WITH_LITELLM_DB_PASSWORD@127.0.0.1:5432/litellm

# Administration only: never place this in Open WebUI, browser, Flutter, or a
# user-facing client.
LITELLM_MASTER_KEY=REPLACE_WITH_LONG_RANDOM_VALUE

# Azure AI Foundry serverless deployment key for Kimi.  This is distinct from
# Microsoft Entra DefaultAzureCredential authentication.
AZURE_AI_API_KEY=REPLACE_WITH_AZURE_AI_FOUNDRY_DEPLOYMENT_KEY

# Required by LiteLLM for a daily reset at Taiwan local midnight.
TZ=Asia/Taipei
