# ====================================
# LLM API Keys
# ====================================

# Google AI Studio API Key
# 取得位置: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy...

# OpenAI API Key (可選)
# 取得位置: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Local TabbyAPI / ExLlamaV2 endpoint (可選)
# LiteLLM config.yaml 預設會連到 http://127.0.0.1:5000/v1
# 如果 TabbyAPI 啟用了 API key，請同步更新 config.yaml 的 api_key / x-api-key。
TABBY_API_BASE=http://127.0.0.1:5000/v1
TABBY_API_KEY=tabby-local

# ====================================
# MCP & Agents
# ====================================

# 本地 MCP 伺服器 URL
MCP_LOCAL_URL=http://127.0.0.1:8090/mcp

# 遠端 MCP 伺服器 URL (Word MCP)
MCP_OFFICE_URL=http://192.168.50.239:9000/mcp

# ====================================
# LiteLLM Gateway 設定
# ====================================

# Gateway 監聽端口 (預設 4000)
# LITELLM_PORT=4000

# Gateway 主機地址 (預設 127.0.0.1)
# LITELLM_HOST=127.0.0.1

# 啟用詳細日誌 (預設 false)
# LITELLM_DEBUG=true

# ====================================
# Open-WebUI 整合設定
# ====================================

# Open-WebUI 連接到此 Gateway 的 URL
# 在 Open-WebUI 中設定:
#   OPENAI_API_BASE_URL=http://localhost:4000/v1
#   OPENAI_API_KEY=sk-1234

# ====================================
# 安全性設定 (生產環境)
# ====================================

# LiteLLM Master Key (生產環境建議設定)
# 留空表示不需要認證 (僅限本地開發)
# LITELLM_MASTER_KEY=your-secret-key-here
