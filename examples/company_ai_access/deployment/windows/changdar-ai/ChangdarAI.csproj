<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>changdar-ai-setup</AssemblyName>
    <RootNamespace>ChangdarAI</RootNamespace>
    <Version>1.3.0</Version>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <EmbeddedResource Condition="'$(PayloadDirectory)' != ''" Include="$(PayloadDirectory)/*" LogicalName="payload.%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="RequirePayload" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'$(PayloadDirectory)' == ''" Text="Supply a reviewed, signed PayloadDirectory." />
  </Target>
</Project>
