# This file is read only by the ai-usage process.  Copy it to the repository
# root as .env.ai_usage, fill in the values, and keep the real file mode 0600.
# Never put LITELLM_MASTER_KEY, Azure/OpenAI provider keys, Open WebUI keys, or
# a Keycloak client secret in this file.

# LiteLLM Proxy and a virtual key limited to GET /spend/logs/v2 only.
AI_USAGE_LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_USAGE_READER_KEY=sk-REPLACE_WITH_VISIONNAIRE_USAGE_READER_KEY

# Keep this aligned with litellm_settings.max_end_user_budget_id's budget.
AI_USAGE_DAILY_BUDGET_USD=4.00
AI_USAGE_TIMEZONE=Asia/Taipei

# Keycloak resource-server settings.  These are public verification values;
# no Keycloak client secret is required.  Values may match Visionnaire's
# existing OIDC_* settings, but AI_USAGE_* keeps this service self-contained.
AI_USAGE_OIDC_ISSUER_URL=https://changdar-server.mooo.com/keycloak/realms/visionnaire
AI_USAGE_OIDC_JWKS_URL=https://changdar-server.mooo.com/keycloak/realms/visionnaire/protocol/openid-connect/certs
AI_USAGE_OIDC_AUDIENCE=visionnaire-api
AI_USAGE_OIDC_ALGORITHMS=RS256
AI_USAGE_OIDC_JWKS_CACHE_SECONDS=300
AI_USAGE_OIDC_JWKS_TIMEOUT_SECONDS=5

# Bounded internal query settings.  A request fails closed instead of showing
# an inaccurate remaining budget if one user's current day exceeds this cap.
AI_USAGE_REQUEST_TIMEOUT_SECONDS=15
AI_USAGE_LOG_PAGE_SIZE=1000
AI_USAGE_MAX_LOG_PAGES=100
AI_USAGE_MAX_RECORD_LIMIT=100

# Used only for presentation; LiteLLM's actual recorded spend remains the
# source of truth.  Add local deployments here when they are introduced.
AI_USAGE_LOCAL_MODEL_NAMES=qwen3.5-35b-a3b,gpt-oss-20b
