# Include inside the existing HTTPS server. Replace approved LAN/VPN ranges.
# NEVER proxy the private authority through the public WebUI location.
location ^~ /internal/company-mcp {
    return 404;
}

location = /company-mcp {
    allow 127.0.0.1;
    allow 192.168.1.0/24;
    # Add the exact approved employee VPN ranges, matching the MCP allowlist.
    deny all;
    proxy_pass http://127.0.0.1:18090;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 130s;
    proxy_send_timeout 130s;
}

location = /.well-known/oauth-protected-resource/company-mcp {
    allow 127.0.0.1;
    allow 192.168.1.0/24;
    deny all;
    proxy_pass http://127.0.0.1:18090;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
}
