# Include from the existing Nginx http context, e.g. /etc/nginx/conf.d/.
# For a private remote gateway, set listen and allow to its specific network IPs.
server {
    listen 127.0.0.1:5002;
    server_name _;
    allow 127.0.0.1;
    deny all;
    access_log off;
    client_max_body_size 32m;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_connect_timeout 10s;
    proxy_read_timeout 1800s;
    proxy_send_timeout 1800s;
    # Administrative endpoints stay private to the inference host.
    location = /v1/models { proxy_pass http://127.0.0.1:5003; }
    location = /v1/chat/completions { proxy_pass http://127.0.0.1:5003; }
    location / { return 404; }
}
