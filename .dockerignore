# The union of public inputs used by the root Dockerfile targets.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!README.md
!CONTRIBUTING.md
!LICENSE
!examples/__init__.py
!examples/identity/**/*.py
!examples/identity/README*.md
!examples/bff/**/*.py
!examples/bff/README*.md
!examples/db_management/**/*.py
!examples/db_management/README*.md
!examples/deployment/__init__.py
!examples/deployment/cli.py
!examples/deployment/registry/**/*.py
!examples/deployment/registry/README*.md
!examples/shared/**/*.py
!examples/shared/**/README*.md
!company_agent/services/office/worker.py
!company_agent/services/cad/worker/CadReader.csproj
!company_agent/services/cad/worker/Program.cs
!company_agent/services/cad/worker/dxf_worker.py

# Keep exclusions last so nested directories cannot re-include private data.
**/.env*
**/*.key
**/*.pem
**/*.pfx
**/*.p12
**/config.local.*
**/ocr-vllm.local.yaml
**/private/**
**/keys/**
**/__pycache__/**
**/*.py[cod]
**/.pytest_cache/**
**/.venv*/**
**/archive/**
**/artifacts/**
**/build/**
**/dist/**
**/*.egg-info/**
